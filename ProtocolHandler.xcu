<?xml version="1.0" encoding="UTF-8"?>
<!--
  The HandlerSet node name MUST be the implementation name registered by
  g_ImplementationHelper in signdocs_addon.py. If the two drift, the menu
  entries appear but every click is a no-op, with nothing in the log.
-->
<oor:component-data
    xmlns:oor="http://openoffice.org/2001/registry"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="ProtocolHandler"
    oor:package="org.openoffice.Office">

  <node oor:name="HandlerSet">
    <node oor:name="br.com.signdocs.libreoffice.ProtocolHandler" oor:op="replace">
      <prop oor:name="Protocols" oor:type="oor:string-list">
        <value>br.com.signdocs.libreoffice:*</value>
      </prop>
    </node>
  </node>

</oor:component-data>
